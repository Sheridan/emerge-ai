{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "doom_loop": "allow",
    "question": "deny",
    "external_directory": {
      "*": "deny",
      "/tmp/**": "allow",
      "/var/db/repos/aimerge-test/**": "allow",
      "/etc/portage/repos.conf/aimerge*": "allow"
    },
    "bash": {
      "*": "allow",
      "sudo *": "allow",
      "emerge *": "deny",
      "sudo emerge *": "deny",
      "aimerge *": "deny",
      "sudo aimerge *": "deny",
      "ebuild *": "deny",
      "sudo ebuild *": "deny",
      "etc-update *": "deny",
      "sudo etc-update *": "deny",
      "dispatch-conf *": "deny",
      "sudo dispatch-conf *": "deny",
      "eselect *": "deny",
      "sudo eselect *": "deny",
      "systemctl *": "deny",
      "sudo systemctl *": "deny",
      "rc-service *": "deny",
      "reboot *": "deny",
      "sudo reboot *": "deny",
      "shutdown *": "deny",
      "sudo shutdown *": "deny",
      "halt *": "deny",
      "poweroff *": "deny",
      "mount *": "deny",
      "sudo mount *": "deny",
      "umount *": "deny",
      "sudo umount *": "deny",
      "btrfs *": "deny",
      "sudo btrfs *": "deny",
      "mkfs *": "deny",
      "sudo mkfs *": "deny",
      "dd *": "deny",
      "sudo dd *": "deny",
      "rm * /etc/*": "deny",
      "rm * /usr/*": "deny",
      "rm * /var/*": "deny",
      "sudo rm * /etc/*": "deny",
      "sudo rm * /usr/*": "deny",
      "sudo rm * /var/*": "deny",
      "rm -rf / *": "deny",
      "sudo rm -rf / *": "deny",
      "emerge --version": "allow",
      "emerge -p": "allow",
      "emerge -p *": "allow",
      "emerge --pretend": "allow",
      "emerge --pretend *": "allow",
      "emerge --info": "allow",
      "emerge --info *": "allow",
      "sudo emerge --version": "allow",
      "sudo emerge -p": "allow",
      "sudo emerge -p *": "allow",
      "sudo emerge --pretend": "allow",
      "sudo emerge --pretend *": "allow",
      "sudo emerge --info": "allow",
      "sudo emerge --info *": "allow",
      "aimerge --version": "allow",
      "aimerge -p": "allow",
      "aimerge -p *": "allow",
      "aimerge --pretend": "allow",
      "aimerge --pretend *": "allow",
      "aimerge --info": "allow",
      "aimerge --info *": "allow",
      "sudo aimerge --version": "allow",
      "sudo aimerge -p": "allow",
      "sudo aimerge -p *": "allow",
      "sudo aimerge --pretend": "allow",
      "sudo aimerge --pretend *": "allow",
      "sudo aimerge --info": "allow",
      "sudo aimerge --info *": "allow",
      "ebuild * manifest": "allow",
      "sudo ebuild * manifest": "allow",
      "btrfs subvolume list *": "allow",
      "btrfs subvolume show *": "allow",
      "sudo btrfs subvolume list *": "allow",
      "sudo btrfs subvolume show *": "allow",
      "rm * /var/db/repos/aimerge-test*": "allow",
      "sudo rm * /var/db/repos/aimerge-test*": "allow"
    }
  }
}
